# ── AI 원고 생성 (선택) ──────────────────────────────────
# 설정하면 Claude 가 원고를 생성합니다. 없으면 템플릿 모드로 동작합니다.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5

# ── 이미지 폴더 (선택) ───────────────────────────────────
# "폴더에서 찾기" 모드의 기본 경로. 비우면 blog_automation/assets/images
BLOG_IMAGE_FOLDER=

# ── 네이버 블로그 자동 발행 ──────────────────────────────
NAVER_ID=
NAVER_PW=
NAVER_BLOG_ID=        # 비우면 NAVER_ID 사용

# ── 티스토리 자동 발행 (카카오 계정) ─────────────────────
KAKAO_ID=
KAKAO_PW=
TISTORY_BLOG=         # https://{TISTORY_BLOG}.tistory.com
