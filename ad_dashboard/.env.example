# ============================================================
# 통합 광고 대시보드 API 자격증명
# 이 파일을 .env 로 복사한 뒤 사용할 플랫폼의 값만 채우면 됩니다.
# 하나도 채우지 않으면 데모 모드(샘플 데이터)로 동작합니다.
# ============================================================

# --- 네이버 검색광고 (https://manage.searchad.naver.com > 도구 > API 사용 관리) ---
NAVER_SEARCHAD_API_KEY=
NAVER_SEARCHAD_SECRET_KEY=
NAVER_SEARCHAD_CUSTOMER_ID=
# 캠페인 자동 세팅 시 광고그룹에 연결할 비즈채널 키 (선택)
NAVER_SEARCHAD_PC_CHANNEL_KEY=
NAVER_SEARCHAD_MOBILE_CHANNEL_KEY=

# --- 네이버 GFA (성과형 디스플레이광고 — 제휴 승인 후 발급) ---
NAVER_GFA_ACCESS_TOKEN=
NAVER_GFA_ACCOUNT_NO=
# 승인 문서에 안내된 베이스 URL 이 다르면 여기서 변경
NAVER_GFA_BASE_URL=

# --- 카카오 (developers.kakao.com > 키워드광고/모먼트 API) ---
KAKAO_ACCESS_TOKEN=
KAKAO_KEYWORD_AD_ACCOUNT=
KAKAO_MOMENT_AD_ACCOUNT=

# --- 구글 애즈 (검색 + GDN 공용, https://developers.google.com/google-ads/api) ---
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# --- 메타 (developers.facebook.com > Marketing API) ---
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
META_PAGE_ID=

# --- GA4 (서비스 계정 키 JSON + 속성 ID) ---
GA4_PROPERTY_ID=
GOOGLE_APPLICATION_CREDENTIALS=

# --- Microsoft Clarity (프로젝트 설정 > Data Export > API 토큰) ---
CLARITY_API_TOKEN=
